<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dog Pic Generator</title>
    <link href="/css/style.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Buda:wght@300&family=Oswald:wght@200..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Roboto+Slab:wght@100..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="title-box">
      <h1 id="title" class="A1">Welcome to Dog pic Generator</h1>
      <h5 id="message" class="B1">
        Incase of no Image Generated Kindly wait for few seconds then rehit the
        button!
      </h5>
    </div>
    <div class="big-box">
      <div class="box-1">
        <div class="input-field">
          <input
            type="text"
            name="dogBreed"
            id="dog"
            placeholder="Enter Dog Breed (ex : husky , pug )"
          />
        </div>
        <div class="btn-class">
          <button onclick="getImage()" class="btn">Get Dog Pic</button>
        </div>
      </div>
      <div id="result">
        <img
          src="images/DOG.png"
          alt="dog_image"
          style="transform: scale(1); opacity: 1"
        />
        <a
          href="/breeds"
          target="_blank"
          style="font-size: 18px"
          id="breed-link"
          >Click Here to View Available Dog Breeds</a
        >
      </div>
    </div>
    <script src="/js/script.js"></script>
  </body>
</html>
